# Puerto público de la miniweb Docker.
F1_DASHBOARD_PORT=8080

# Activa o desactiva Live Timing en el backend.
F1_LIVE_ENABLED=true

# Inicia automáticamente la captura según el calendario de F1.
F1_SCHEDULER_ENABLED=true

# Frecuencia con la que se consulta el calendario.
F1_SCHEDULER_POLL_SECONDS=30

# Inicia la captura cinco minutos antes de la sesión.
F1_SCHEDULER_LEAD_SECONDS=300

# Límite de seguridad de cada captura: seis horas.
F1_SCHEDULER_MAX_SESSION_SECONDS=21600